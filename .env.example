# ==============================================================================
# AeroPOS UAE - Environment Configuration Template
# Copy this file to '.env' and fill in your Supabase credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project API Credentials
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_REF="your-supabase-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Public / Anon Key (Safe for browser clients, restricted by Row-Level Security)
SUPABASE_ANON_KEY="your-supabase-publishable-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Service Role Secret Key (Bypasses RLS - SERVER / SCRIPT / SEED USE ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
SUPABASE_DB_HOST="db.your-project-ref.supabase.co"
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="postgres"

# Supabase database password configured when creating the project
SUPABASE_DB_PASSWORD="your-supabase-database-password"

# ------------------------------------------------------------------------------
# 3. Connection Strings
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection (Port 5432 - For CLI migrations, schema changes, seeds)
DATABASE_URL_DIRECT="postgresql://postgres:${SUPABASE_DB_PASSWORD}@db.your-project-ref.supabase.co:5432/postgres"

# Transaction Pooler (Port 6543 - Recommended for Serverless, Netlify Functions, and SSR)
DATABASE_URL_POOLER="postgresql://postgres.your-project-ref:${SUPABASE_DB_PASSWORD}@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Pooler (Port 5432 - For long sessions via pooler)
DATABASE_URL_SESSION="postgresql://postgres.your-project-ref:${SUPABASE_DB_PASSWORD}@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 4. AeroPOS Business & Localization Settings
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY="AED"
DEFAULT_TAX_RATE=0.05
DEFAULT_LOCALE="en-AE"
ALLOW_NEGATIVE_STOCK=false
INVOICE_PREFIX="INV"

# ------------------------------------------------------------------------------
# 5. Build & Deployment Settings
# ------------------------------------------------------------------------------
NPM_FLAGS="--legacy-peer-deps"
